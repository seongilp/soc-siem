{
  "type": "monitor",
  "name": "SSH brute force 후 로그인 성공",
  "monitor_type": "bucket_level_monitor",
  "enabled": true,
  "schedule": { "period": { "interval": 1, "unit": "MINUTES" } },
  "inputs": [{
    "search": {
      "indices": ["siem-linux-auth-*"],
      "query": {
        "size": 0,
        "query": { "bool": { "filter": [
          { "range": { "@timestamp": { "gte": "{{period_end}}||-10m", "lte": "{{period_end}}", "format": "epoch_millis" } } },
          { "terms": { "event_action": ["Failed", "Accepted"] } }
        ] } },
        "aggs": {
          "by_source": {
            "composite": { "size": 50, "sources": [ { "source_ip": { "terms": { "field": "source_ip" } } } ] },
            "aggs": {
              "failed":   { "filter": { "term": { "event_action": "Failed" } } },
              "accepted": { "filter": { "term": { "event_action": "Accepted" } } }
            }
          }
        }
      }
    }
  }],
  "triggers": [{
    "bucket_level_trigger": {
      "name": "실패 5회 이상 + 성공 1회 이상",
      "severity": "1",
      "condition": {
        "buckets_path": { "failed": "failed>_count", "accepted": "accepted>_count" },
        "parent_bucket_path": "by_source",
        "script": { "source": "params.failed >= 5 && params.accepted >= 1", "lang": "painless" },
        "gap_policy": "skip"
      },
      "actions": []
    }
  }]
}
