{
  "index_patterns": ["siem-web-access-*"],
  "priority": 200,
  "template": {
    "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
    "mappings": {
      "properties": {
        "@timestamp":    { "type": "date" },
        "event_dataset": { "type": "keyword" },
        "host":          { "type": "keyword" },
        "source_ip":     { "type": "ip" },
        "http_method":   { "type": "keyword" },
        "url_original":  { "type": "keyword", "fields": { "text": { "type": "text" } } },
        "url_path":      { "type": "keyword", "fields": { "text": { "type": "text" } } },
        "url_query":     { "type": "keyword", "fields": { "text": { "type": "text" } } },
        "http_status":   { "type": "integer" },
        "body_bytes":    { "type": "long" },
        "request_time":  { "type": "float" },
        "referrer":      { "type": "keyword" },
        "user_agent":    { "type": "keyword", "fields": { "text": { "type": "text" } } }
      }
    }
  }
}
